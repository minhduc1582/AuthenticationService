{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Aspire.Hosting.Dcp": "Warning"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "https://localhost:5173",
      "https://localhost:7194",
      "http://localhost:7194"
    ]
  },
  "Authentication": {
    "DefaultRedirectUrl": "http://localhost:5173/",
    "Cookie": {
      "Name": "__Host-auth",
      "SameSite": "Lax",
      "ExpireMinutes": 60,
      "RememberMeDays": 14,
      "Domain": "",
      "Secure": true
    }
  },
  "Jwt": {
    "Issuer": "AuthenticationAPI",
    "Audience": "AuthenticationAPIClients",
    "SigningKey": "PLEASE_CHANGE_ME_TO_A_SECURE_VALUE",
    "AccessTokenLifetimeMinutes": 60
  }
}
